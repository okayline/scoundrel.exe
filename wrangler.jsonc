{
  // The Worker's name must match the one in the Cloudflare dashboard.
  "name": "scoundrel-exe",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // The site's files (index.html etc). /api/* goes to the Worker code first.
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*"]
  },
  // the game's home. The old workers.dev address redirects here (see CANONICAL_HOST).
  "routes": [
    { "pattern": "scoundrel.88x31.app", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scoundrel-db",
      "database_id": "75e13945-0776-4fb0-bbaf-8e89119a7d59"
    }
  ],
  // save codes and passkeys: the shared Accounts service (the dungeon-items Worker, `Accounts` entrypoint; see its ACCOUNTS.md).
  // dungeon-items must be deployed first.
  // and the copy registry (same Worker, `Registry` entrypoint): every finished run checkpoints this ledger there.
  "services": [
    { "binding": "ACCOUNTS", "service": "dungeon-items", "entrypoint": "Accounts" },
    { "binding": "REGISTRY", "service": "dungeon-items", "entrypoint": "Registry" }
  ],
  "vars": {
    // Day #1 of the daily deck (UTC). Share cards say "scoundrel.exe #N".
    "LAUNCH_DAY": "2026-10-14",
    // requests to any *.workers.dev address are sent here instead (passkeys belong to one address)
    "CANONICAL_HOST": "scoundrel.88x31.app"
  }
  // Secret (not in this file): DAILY_SECRET, the key that makes each day's deck.
  //   npx wrangler secret put DAILY_SECRET
}
